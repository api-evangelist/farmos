            "url": "https://{farmOS-host}/api/quantity/standard/:id",
            "params": [
              {
                "name": "id",
                "value": "3f1c2b4a-5d6e-7890-abcd-ef1234567890",
                "type": "path",
                "description": "UUID of the resource"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a standard quantity"
        },
        {
          "info": {
            "name": "Delete a standard quantity",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{farmOS-host}/api/quantity/standard/:id",
            "params": [
              {
                "name": "id",
                "value": "3f1c2b4a-5d6e-7890-abcd-ef1234567890",
                "type": "path",
                "description": "UUID of the resource"
              }
            ]
          },
          "docs": "Delete a standard quantity"
